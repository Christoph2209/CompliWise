# Copy this file to .env (in the repo root) and fill it in.
# Do NOT commit .env to GitHub -- it holds your secrets.

# --- Required -------------------------------------------------------------

# Postgres connection string for the backend and Alembic migrations.
# (Docker Compose sets its own DATABASE_URL from the POSTGRES_* values below.)
DATABASE_URL=postgresql://username:password@localhost:5432/compliwise

# Signs the login session cookie. Use a long random value and keep it secret;
# changing it logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Optional -------------------------------------------------------------

# Label stored on generated schedule runs.
SCHOOL_YEAR=2026-2027

# Frontend address(es) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Set to true when the site is served over HTTPS, so the session cookie
# is only ever sent over HTTPS.
COOKIE_SECURE=false

# --- Docker Compose only --------------------------------------------------

POSTGRES_USER=compliwise
POSTGRES_PASSWORD=changeme
POSTGRES_DB=compliwise

# Address staff browsers use to reach the backend. Baked into the frontend
# at build time, so rebuild the frontend image after changing it.
VITE_API_URL=http://localhost:8000
